{"$id":"https://justinahiggins614-cmyk.github.io/signature-boundless-generators/schema/manifest.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","description":"The authoritative manifest of the Boundless Generator Archive. data/manifest.json is the ONE count source: homepage, archive, search, API, sitemap, and AI docs all read from it. Rebuilt by code/seed.py on every drip.","properties":{"archive_version":{"description":"YYYY-MM-DD of the last drip that modified the archive.","type":"string"},"canonical_url":{"type":"string"},"chunk_manifest":{"description":"Per-chunk integrity records.","items":{"properties":{"chunk":{"type":"string"},"count":{"type":"integer"},"first_id":{"type":"string"},"last_id":{"type":"string"},"sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"}},"required":["chunk","first_id","last_id","count","sha256"],"type":"object"},"type":"array"},"chunks":{"items":{"type":"string"},"type":"array"},"count":{"description":"Total archived outputs. Must equal index rows and sum(per_family).","type":"integer"},"drip_history":{"items":{"properties":{"added":{"type":"integer"},"date":{"type":"string"},"per_family":{"type":"integer"}},"required":["date","added","per_family"],"type":"object"},"type":"array"},"earliest_ids":{"description":"First archived output per family.","type":"object"},"engine_version":{"type":"string"},"family_ids":{"description":"Permanent family IDs: family key -> JAH-GF-##.","type":"object"},"generator_version":{"type":"string"},"goal":{"type":"integer"},"id_scheme":{"type":"string"},"index_sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"index_url":{"type":"string"},"index_version":{"type":"string"},"latest_ids":{"description":"Latest archived output per family.","type":"object"},"per_family":{"description":"Archived outputs per family key.","type":"object"},"schema_version":{"type":"string"},"site":{"type":"string"},"site_id":{"type":"string"},"site_number":{"type":"integer"},"updated":{"description":"ISO-